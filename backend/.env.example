# ── TraceVault backend ─────────────────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=TraceVault
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# PostgreSQL (production). Example:
# DATABASE_URL=postgresql+psycopg://tracevault:tracevault@localhost:5432/tracevault
# Zero-dependency local fallback:
DATABASE_URL=sqlite:///./tracevault.db
AUTO_CREATE_TABLES=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2048
READ_ONLY_ORIGINALS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Accepted upload extensions (comma separated)
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,mp3,wav,m4a,aac,flac,ogg,opus,aiff,aif,wma,amr,mp4,m4v,mov,mkv,webm,avi,wmv,flv,mpg,mpeg,3gp,ogv,txt,json,csv,eml

DEFAULT_ACTOR=Aarav Shah
DEFAULT_ACTOR_EMAIL=aarav.shah@kestrel.legal
DEFAULT_PASSWORD=tracevault
TIMEZONE=Asia/Kolkata

# Authentication. AUTH_REQUIRED=false keeps local Swagger usable; set true to
# protect every API route (the frontend signs in either way).
AUTH_REQUIRED=false
AUTH_SESSION_DAYS=7

# Gemini — powers embeddings (and chat when AI_PROVIDER=google).
# Leave blank to skip vector retrieval and use extractive Q&A.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_VISION_FALLBACK=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=50

# Alternative chat provider: OpenCode inference gateway.
# AI_PROVIDER=google (default) | opencode
# With opencode, set OPENCODE_API_KEY and OPENCODE_MODEL. The API shape is
# chosen from the model: Gemini models use /google/v1beta, others /openai/v1.
# Use https://opencode.ai/inference/go for a Go subscription, or
# https://opencode.ai/inference for Console pay-as-you-go.
# Embeddings still use GEMINI_API_KEY above; the gateway serves no embeddings.
AI_PROVIDER=google
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_CHAT_BASE=https://opencode.ai/inference/go

# Retrieval-augmented generation
RAG_ENABLED=true
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS=5000
RAG_MIN_VECTOR_MATCH=0.52

# OCR: auto selects EasyOCR → PaddleOCR → Tesseract → Gemini vision.
OCR_ENGINE=auto
OCR_LANGUAGES=en
OCR_GPU=false
MAX_PDF_OCR_PAGES=40

# Whisper ASR. "small" is the recommended balance; use "tiny" for demos.
WHISPER_MODEL=small
WHISPER_LANGUAGE=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FRAME_INTERVAL_SECONDS=8
MAX_VIDEO_FRAMES=12

# Limits
MAX_TEXT_CHARS_FOR_AI=24000
ASSISTANT_MAX_SOURCES=8
DEMO_AUDIO_MODEL=false
